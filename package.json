{
  "name": "jobs-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.browser.json",
    "build:admin": "tsc -p tsconfig.browser.json",
    "typecheck": "tsc --noEmit",
    "search:linkedin": "node --import tsx/esm scripts/generate-linkedin-searches.ts",
    "search:linkedin:dry": "node --import tsx/esm scripts/generate-linkedin-searches.ts --dry-run",
    "import:linkedin": "node --import tsx/esm scripts/linkedin-importer.ts",
    "import:linkedin:dry": "node --import tsx/esm scripts/linkedin-importer.ts --dry-run",
    "ingest:jobs": "node --import tsx/esm scripts/ingest-jobs.ts data/jobs.sample.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml": ">=5.2.2",
    "protobufjs": ">=7.6.5",
    "brace-expansion": ">=5.0.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "md-to-pdf": "^5.2.5",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "puppeteer": "^25.6.0"
  }
}
