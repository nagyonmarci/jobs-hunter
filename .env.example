POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus-local-password

# Basic Auth credentials for the admin UI/API. Use real values outside local dev.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Import all sources hourly; check expiration daily. -1 processes all searches/jobs.
IMPORT_INTERVAL_HOURS=1
EXPIRE_CHECK_INTERVAL_HOURS=24
SCHEDULED_RUN_LIMIT=12
SCHEDULED_MAX_JOBS_PER_RUN=-1
LINKEDIN_REQUEST_DELAY_MS=2500
